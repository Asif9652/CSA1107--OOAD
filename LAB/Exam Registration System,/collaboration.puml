
@startuml

object Student
object "Exam Registration System" as System
object "Exam Database" as DB
object "Payment Gateway" as Payment
object "Hall Ticket Service" as Ticket

Student --> System : 1. Login
System --> DB : 1.1 Verify Student
DB --> System : 1.2 Student Details
System --> Student : 1.3 Login Success

Student --> System : 2. View Exams
System --> DB : 2.1 Fetch Exam Details
DB --> System : 2.2 Exam Details

Student --> System : 3. Select Subjects
System --> DB : 3.1 Check Eligibility
DB --> System : 3.2 Eligibility Status

Student --> System : 4. Confirm Registration
System --> Payment : 4.1 Process Payment
Payment --> System : 4.2 Payment Status

System --> DB : 5. Save Registration
System --> Ticket : 6. Generate Hall Ticket
Ticket --> Student : 7. Hall Ticket

@enduml
