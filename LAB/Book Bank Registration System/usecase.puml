
@startuml
title Book Bank Registration System - Use Case Diagram
left to right direction

actor Student
actor "Book Bank Administrator" as Admin

rectangle "Book Bank Registration System" {
  usecase "Student Registration" as UC1
  usecase "Student Details" as UC2
  usecase "Request Book" as UC3
  usecase "Check Book Availability" as UC4
  usecase "Issue Book" as UC5
  usecase "Return Book" as UC6
  usecase "Cancel Book Request" as UC7
}

Student -- UC1
Student -- UC2
Student -- UC3
Student -- UC6
Student -- UC7

Admin -- UC2
Admin -- UC4
Admin -- UC5
Admin -- UC6
Admin -- UC7

UC3 ..> UC4 : <<include>>
UC5 ..> UC4 : <<include>>

@enduml
